# Copy to .env (never commit .env)
PORT=3000
NODE_ENV=development

# Admin login (10+ character password). Re-synced every time the server starts.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-this-long-password
# Required in production: 32+ random characters (see README for a command to make one)
SESSION_SECRET=

# Contact. OWNER_WHATSAPP = your number, digits only, with country code. This alone is enough:
# the form saves the enquiry and opens WhatsApp with the message ready (no Meta account needed).
OWNER_WHATSAPP=260971234567

# OPTIONAL automatic delivery via Meta WhatsApp Cloud API (leave empty to skip)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Optional: where data lives. On Render, point these at a persistent disk (e.g. /var/data)
# DB_PATH=/var/data/portfolio.db
# UPLOAD_DIR=/var/data/uploads

# Public contact buttons on the site (all optional)
# SITE_WHATSAPP is the number visitors chat with; it falls back to OWNER_WHATSAPP
# SITE_WHATSAPP=260971234567
CONTACT_EMAIL=arbelarts1.2@gmail.com
FACEBOOK_URL= https://www.facebook.com/profile.php?id=100081810042517
